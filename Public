-- Helper Function to forcefully trigger ProximityPrompts instantly
local function ForceInteract(prompt)
    if prompt and prompt:IsA("ProximityPrompt") then
        local oldLineOfSight = prompt.RequiresLineOfSight
        local oldMaxDistance = prompt.MaxActivationDistance
        local oldHoldDuration = prompt.HoldDuration
        
        -- Bypass constraints
        prompt.RequiresLineOfSight = false
        prompt.MaxActivationDistance = 99999
        prompt.HoldDuration = 0
        
        -- Trigger
        pcall(function() fireproximityprompt(prompt) end)
        
        -- Restore original settings safely
        task.wait(0.1)
        prompt.RequiresLineOfSight = oldLineOfSight
        prompt.MaxActivationDistance = oldMaxDistance
        prompt.HoldDuration = oldHoldDuration
    end
end

-- Helper Function to Unveil, Place instantly, and Use items for massive XP
local function SpamItems(tableNumber)
    -- 1. Unveil the items from the chest
    pcall(function() 
        itemDealingRemote:FireServer({{action = "unveil", tableId = tableNumber}}) 
    end)
    
    -- 2. Spam Place into all 8 slots simultaneously via parallel threads
    for i = 1, 8 do
        task.spawn(function()
            pcall(function() 
                itemDealingRemote:FireServer({{tableId = tableNumber, itemIndex = i, action = "place"}}) 
            end)
        end)
    end
    
    -- Give the server a brief window to process the placement
    task.wait(0.3)
    
    -- 3. Scan table props and use everything except Adrenaline
    local tablesPath = workspace:FindFirstChild("gamespace") and workspace.gamespace:FindFirstChild("tables")
    local tableFolder = tablesPath and tablesPath:FindFirstChild(tostring(tableNumber))
    
    if tableFolder then
        local gameProps = tableFolder:FindFirstChild("gameProps")
        if gameProps then
            for _, item in pairs(gameProps:GetChildren()) do
                -- Filter out item names containing "adrenaline" (case-insensitive)
                if not string.match(string.lower(item.Name), "adrenaline") then
                    
                    -- Attempt to use item. NOTE: If your game utilizes a separate remote 
                    -- for item usage rather than PlayerAction, modify this line.
                    pcall(function() 
                        playerActionRemote:FireServer(tableNumber, item.Name) 
                    end)
                    
                    task.wait(0.1) 
                end
            end
        end
    end
end



-- Solo Auto Farm (vs Bots)
Tabs.Farm:AddToggle("AutoFarmToggle", {
    Title = "Solo Auto Farm (Bots)",
    Default = false,
    Description = "Automates finding tables, requesting bots, spamming items for XP, and cycling rounds.",
    Callback = function(Value)
        FarmingActive = Value
        if FarmingActive then
            task.spawn(function()
                while FarmingActive do
                    local targetPrompt, targetSeat, targetTable
                    local tablesFolder = workspace:FindFirstChild("gamespace") and workspace.gamespace:FindFirstChild("tables")
                    
                    if tablesFolder then
                        for _, tableFolder in pairs(tablesFolder:GetChildren()) do
                            local spots = tableFolder:FindFirstChild("spots")
                            if spots and #spots:GetChildren() == 2 then
                                local isOccupied = false
                                for _, spot in pairs(spots:GetChildren()) do
                                    if spot:IsA("Seat") and spot.Occupant then isOccupied = true break end
                                end
                                
                                if not isOccupied then
                                    targetPrompt = tableFolder:FindFirstChildWhichIsA("ProximityPrompt", true)
                                    targetSeat = spots:FindFirstChild("1")
                                    targetTable = tableFolder
                                    break
                                end
                            end
                        end
                    end

                    if targetPrompt and targetSeat and LocalPlayer.Character then
                        LocalPlayer.Character:PivotTo(targetSeat.CFrame + Vector3.new(0, 1, 0))
                        
                        local sitAttempts = 0
                        while FarmingActive and not (LocalPlayer.Character:FindFirstChild("Humanoid") and LocalPlayer.Character.Humanoid.Sit) and sitAttempts < 10 do
                            ForceInteract(targetPrompt)
                            task.wait(0.5)
                            sitAttempts = sitAttempts + 1
                        end
                        
                        local currentTableNumber = tonumber(targetTable.Name) or 6
                        pcall(function() requestBotsRemote:FireServer() end)
                        task.wait(3)
                        
                        while FarmingActive and LocalPlayer.Character.Humanoid.Sit do
                            
                            SpamItems(currentTableNumber)
                            task.wait(0.5)
                            
                            
                            local argsShoot = {currentTableNumber, "shotgun", 0, game:GetService("Players"):WaitForChild("XxbestaccxX")}
                            pcall(function() playerActionRemote:FireServer(unpack(argsShoot)) end)
                            
                            task.wait(2)
                        end
                    end
                    task.wait(2)
                end
            end)
        end
    end
})

